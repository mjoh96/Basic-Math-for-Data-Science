   ],
   "source": [
    "import numpy as np\n",
    "u=np.array([1,2,2])\n",
    "v=np.array([2,1,2])\n",
    "w=np.array([2,-2,1])\n",
    "\n",
    "print(\"cos(u,v)=\",np.dot(u,v)/(np.linalg.norm(u)*np.linalg.norm(v)))\n",
    "print(\"cos(u,w)=\",np.dot(u,w)/(np.linalg.norm(u)*np.linalg.norm(w)))"
   ]
  }
 ],
