   "source": [
    "#Ch1 프로그래밍 실습1\n",
    "def f(x):\n",
    "    if x%2==0:\n",
    "        return x/2\n",
    "    else:\n",
    "        return (x+1)/2\n",
    "\n",
    "fval = f(127)\n",
    "n=1\n",
    "while True:\n",
    "    fval=f(fval)\n",
    "    n=n+1\n",
    "    if fval==1:\n",
    "        print(\"fn(127)=1 at n=\",n)\n",
    "        break"
   ]
  }
 ],
