    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# (a) y=0.5(x-1)^2+1\n",
    "x=np.linspace(-3,5,801)\n",
    "y=0.5*(x-1)**2+1\n",
    "plt.plot(x,y,label=r'$y=0.5(x-1)^2+1$')\n",
    "plt.legend()\n",
    "plt.show()"
