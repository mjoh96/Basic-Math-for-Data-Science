    "\n",
    "#Ex 2-9\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "#y=sqrt(2x-3)+4\n",
    "x=np.linspace(1.5,10,1000)\n",
    "y=np.sqrt(2*x-3)+4\n",
    "\n",
    "plt.plot(x,y,label=r'$y=\\sqrt{2x-3}+4$')\n",
    "plt.legend()\n",
    "plt.show"
   ]
