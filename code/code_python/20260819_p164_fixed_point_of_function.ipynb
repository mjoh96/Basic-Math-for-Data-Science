    "import numpy as np\n",
    "\n",
    "def f(x):\n",
    "    return np.sqrt(1+x)\n",
    "\n",
    "x1=3\n",
    "xn=x1\n",
    "xnp1=xn\n",
    "\n",
    "N=15\n",
    "\n",
    "for n in range (1,N+1):\n",
    "    print(\"x\",xn)\n",
    "    xnp1=f(xn)\n",
    "    xn=xnp1"
