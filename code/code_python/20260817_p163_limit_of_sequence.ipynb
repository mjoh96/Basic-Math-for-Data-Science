    "#ch3 프로그래밍 실습 1\n",
    "import numpy as np\n",
    "a,x1 = 3,1\n",
    "xn = x1\n",
    "xnp1=xn\n",
    "N=10\n",
    "\n",
    "for n in range (1,N+1):\n",
    "    print (\"x:\",xn)\n",
    "    xnp1=0.5*(xn+a/xn)\n",
    "    xn=xnp1\n",
    "\n",
    "print(f\"최종값: {xn} ≈ √{round(xn**2)} -> √a로 수렴함\")\n"
   ]
  }
