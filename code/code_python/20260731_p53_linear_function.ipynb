   "source": [
    "#Ex 2-1\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# (a) y=3x+2\n",
    "x=np.linspace(-4,4,801)\n",
    "y=3*x+2\n",
    "plt.plot(x,y,label=\"y=3x+2\")\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "#(b) y=-x-1\n",
    "x=np.linspace(-4,4,801)\n",
    "y=-x-1\n",
    "plt.plot(x,y,label=\"y=-x-1\")\n",
    "plt.legend()\n",
    "plt.show"
   ]
