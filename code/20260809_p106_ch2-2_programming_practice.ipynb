   "source": [
    "#ch2 프로그래밍 실습 2\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def f(x):\n",
    "    return np.sqrt(x)\n",
    "\n",
    "x=np.linspace(0,10,1001)\n",
    "y=f(x)\n",
    "plt.plot(x,y,label=r\"$f(x)$\")\n",
    "\n",
    "for i in range (0,6):\n",
    "    y=f(y)\n",
    "    plt.plot(x,y,label=rf\"$f^{{{i+2}}}(x)$\")\n",
    "\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
