   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "#y=tan2(x-pi/2)\n",
    "x=np.linspace(-0.25*np.pi,0.25*np.pi,501)\n",
    "y=np.tan(2*(x-0.5*np.pi))\n",
    "\n",
    "plt.plot(x[10:491],y[10:491],label=r'$y=tan2(x-\\frac{\\pi}{2})$')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
