    "#Ch2 프로그래밍 실습 1\n",
    "import numpy as np\n",
    "\n",
    "def f(x):\n",
    "    return 2**x\n",
    "def g(x):\n",
    "    return 100*x**2+2*x\n",
    "\n",
    "for x in range (1,21):\n",
    "    ratio = f(x)/g(x)\n",
    "    print(\"f(x)/g(x)=\",ratio)"
